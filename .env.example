# Public Supabase configuration.
# These values are intentionally safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Canonical URL used by server-rendered metadata and deployment configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only configuration.
# Keep this key out of browser code, client bundles, logs, and source control.
SUPABASE_SECRET_KEY=replace-with-your-server-only-key

# Optional, but currently unsupported by the rendered form.
# Leave this variable omitted or commented out. If a nonempty value is set,
# POST /api/meeting-requests returns 503 until a Turnstile form token is added.
# TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret